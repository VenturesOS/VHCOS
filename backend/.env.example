# VHC Talent OS — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── MongoDB ───────────────────────────────────────────────────────────────
# Required. The hardcoded credential has been removed from config.py.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vhc_talent_os

# ── LLM / AI ──────────────────────────────────────────────────────────────
EMERGENT_LLM_KEY=your_emergent_llm_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_DEFAULT_MODEL=gpt-4o-mini

# ── Redis (Upstash) ───────────────────────────────────────────────────────
# Required for process-safe caching (embeddings, upload sessions, search).
# Without this, embedding cache and chunked uploads are per-worker (not safe
# under multi-worker Gunicorn deployments).
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vhc-talent-os-storage
# R2_ENDPOINT is optional — defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=https://custom-endpoint.example.com

# ── JWT ───────────────────────────────────────────────────────────────────
# Change this to a long random string in production.
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
