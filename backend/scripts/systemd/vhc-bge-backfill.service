[Unit]
Description=VHC BGE embedding backfill (incremental)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vhc-platform/backend
ExecStart=/home/ubuntu/vhc-platform/backend/scripts/run_bge_backfill.sh --incremental
# Run with low CPU priority so it never starves the FastAPI workers
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
